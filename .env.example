# 教备AI - 环境配置文件
# 复制此文件为 .env 并填写真实API密钥

# ===== AI服务选择 =====
# 可选值：qwen（通义千问）、wenxin（文心一言）、deepseek（DeepSeek）
AI_SERVICE=qwen

# ===== 通义千问 API（推荐）=====
# 获取地址：https://dashscope.aliyun.com/
# 费用：qwen-max约0.04元/千tokens，qwen-plus约0.004元/千tokens
QWEN_API_KEY=你的通义千问API密钥

# ===== 文心一言 API =====
# 获取地址：https://cloud.baidu.com/product/wenxinworkshop
# 费用：约0.012元/千tokens
WENXIN_API_KEY=你的文心一言API_Key
WENXIN_SECRET_KEY=你的文心一言Secret_Key

# ===== DeepSeek API（最便宜）=====
# 获取地址：https://platform.deepseek.com/
# 费用：约0.001元/千tokens（最便宜）
DEEPSEEK_API_KEY=你的DeepSeek_API密钥

# ===== 服务器配置 =====
# 服务端口（默认3000）
PORT=3000

# 环境（development 或 production）
NODE_ENV=development

# ===== 其他配置 =====
# 允许的前端域名（CORS配置，多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 日志级别（debug, info, warn, error）
LOG_LEVEL=info
